---
import Base from "../../layouts/Base.astro";
import { info } from "../../lib/info";
import { getOpenSourceStats, formatCount } from "../../lib/opensource";

const stats = await getOpenSourceStats();
const linkClass =
    "text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors";
---

<Base title={`${info.name} - Open Source`} description={`Open source libraries and contributions by ${info.name}.`}>
    <section class="container mx-auto px-6 pt-16 pb-20 flex-grow">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-4 text-4xl md:text-5xl font-bold tracking-tight text-balance">Open Source</h1>

            <div class="font-mono mb-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                <div>
                    [github:{" "}
                    <a href={stats.profileUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
                        @{info.openSource.github}
                    </a>
                    ]
                </div>
                <div>
                    [followers:{" "}
                    <a
                        href={`${stats.profileUrl}?tab=followers`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                    >
                        {formatCount(stats.followers)}
                    </a>
                    ]
                </div>
                <div>
                    [total stars:{" "}
                    <a
                        href={`${stats.profileUrl}?tab=repositories&sort=stargazers`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                    >
                        {formatCount(stats.totalStars)}
                    </a>
                    ]
                </div>
            </div>

            <div class="mb-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4">Projects</h2>
                <div class="space-y-6">
                    {stats.repos.map(repo => (
                        <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                            <h3 class="text-base font-semibold">
                                <a
                                    href={repo.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-foreground hover:text-accent transition-colors"
                                >
                                    {repo.name}
                                </a>
                            </h3>
                            <p class="text-sm text-foreground/80 text-pretty">{repo.description}</p>
                            <div class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
                                <span>
                                    [stars:{" "}
                                    <a href={repo.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                        {formatCount(repo.stars)}
                                    </a>
                                    ]
                                </span>
                                {repo.forks > 0 && (
                                    <span>
                                        [forks:{" "}
                                        <a
                                            href={`${repo.url}/forks`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class={linkClass}
                                        >
                                            {formatCount(repo.forks)}
                                        </a>
                                        ]
                                    </span>
                                )}
                                {repo.downloads && (
                                    <span>
                                        [{repo.downloads.label}:{" "}
                                        <a
                                            href={repo.downloads.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class={linkClass}
                                        >
                                            {formatCount(repo.downloads.count)}
                                        </a>
                                        ]
                                    </span>
                                )}
                                {repo.award && (
                                    <span>
                                        [award:{" "}
                                        <a
                                            href={repo.award.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class={linkClass}
                                        >
                                            {repo.award.text}
                                        </a>
                                        ]
                                    </span>
                                )}
                                <span>
                                    [commits:{" "}
                                    <a
                                        href={`${repo.url}/commits`}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={linkClass}
                                    >
                                        {formatCount(repo.commits)}
                                    </a>
                                    ]
                                </span>
                                <span>{repo.languages.join(" · ")}</span>
                            </div>
                        </div>
                    ))}
                </div>
                <p class="font-mono mt-6 text-sm">
                    [more:{" "}
                    <a
                        href={`${stats.profileUrl}?tab=repositories`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                    >
                        all my repos on GitHub
                    </a>
                    ]
                </p>
            </div>

            <div>
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4">
                    Featured contributions
                </h2>
                <div class="space-y-6">
                    {stats.contributions.map(item => (
                        <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                            <h3 class="text-base font-semibold">
                                <a
                                    href={item.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-foreground hover:text-accent transition-colors"
                                >
                                    {item.repo}
                                </a>
                            </h3>
                            <p class="text-sm text-foreground/80 text-pretty">{item.description}</p>
                            {item.note && <p class="text-sm text-foreground/80 text-pretty">{item.note}</p>}
                            <ul class="list-disc list-inside space-y-1 text-xs text-muted-foreground">
                                {item.pullRequests.map(pr => (
                                    <li>
                                        <a href={pr.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                            {pr.title}
                                        </a>
                                        {pr.status && <span> ({pr.status})</span>}
                                    </li>
                                ))}
                            </ul>
                            <div class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                                {item.links?.map(link => (
                                    <span>
                                        [{link.label}:{" "}
                                        <a href={link.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                            {link.text}
                                        </a>
                                        ]
                                    </span>
                                ))}
                                {item.allPullRequests && (
                                    <span>
                                        [all:{" "}
                                        <a
                                            href={item.allPullRequests}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class={linkClass}
                                        >
                                            pull requests
                                        </a>
                                        ]
                                    </span>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
                {info.openSource.moreContributions && info.openSource.moreContributions.length > 0 && (
                    <p class="font-mono mt-6 text-sm">
                        [also:{" "}
                        {info.openSource.moreContributions.map((link, i) => (
                            <Fragment>
                                {i > 0 && " · "}
                                <a href={link.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                    {link.text}
                                </a>
                            </Fragment>
                        ))}
                        ]
                    </p>
                )}
            </div>
        </div>
    </section>
</Base>
