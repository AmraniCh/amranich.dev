---
import Base from "../../layouts/Base.astro";
import CopyButton from "../../components/CopyButton.astro";
import { Shield, Briefcase, GraduationCap, BadgeCheck, Award, FolderGit2 } from '@lucide/astro';
import { info, resume, contacts } from "../../lib/info";

const linkClass = "text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors";
// Short version of the home page projects: only the ones with a one line "short" text.
const projects = info.projects.filter((project) => project.short);
---

<Base title={`${resume.name} - Resume`}
      description={`Resume of ${resume.name}: software engineer (backend, DevOps, Linux) and MSc student in Computer Science and Telecommunications in Rabat.`}>

    <section class="container mx-auto px-6 pt-16 pb-20 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">{resume.name}</h1>
            <p class="mb-6 text-lg md:text-xl text-muted-foreground">{resume.role}</p>

            <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                Connect
            </h2>

            <div class="mb-10 p-4 border border-border/70 bg-card rounded-lg">
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                    {contacts.map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class={linkClass}
                            >{contact.text}</a>{contact.copy && <CopyButton value={contact.copy} label={`Copy ${contact.label}`} />}]
                        </div>
                    ))}
                </div>
            </div>

            <div class="mb-10">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                    Summary
                </h2>
                <p class="text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                    {resume.bio}
                </p>
            </div>

            {resume.experience && resume.experience.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Briefcase size={14} class="text-muted-foreground" />
                        <span>Experience</span>
                    </h2>
                    <div class="space-y-6">
                        {resume.experience.map((exp) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1.5">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-base font-semibold text-foreground">
                                        {exp.role} {exp.company && <span class="text-muted-foreground font-normal">@ {exp.company}</span>}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{exp.period}</span>
                                </div>
                                {exp.description.length > 0 && (
                                    <ul class="list-disc list-inside space-y-1 text-sm text-foreground/80">
                                        {exp.description.map((desc) => (
                                            <li class="text-pretty">{desc}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {projects.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <FolderGit2 size={14} class="text-muted-foreground" />
                        <span>Projects</span>
                    </h2>
                    <div class="space-y-4">
                        {projects.map((project) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">{project.title}</h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{project.date}</span>
                                </div>
                                <p class="text-sm text-foreground/80 text-pretty">{project.short}</p>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                                    {project.links.map((link) => (
                                        <span>[{link.label}: <a href={link.url} target="_blank" rel="noopener noreferrer" class={linkClass}>{link.text}</a>]</span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.education && resume.education.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <GraduationCap size={14} class="text-muted-foreground" />
                        <span>Education</span>
                    </h2>
                    <div class="space-y-4">
                        {resume.education.map((edu) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">{edu.degree}</h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{edu.period}</span>
                                </div>
                                {edu.subtitle && <p class="text-xs text-foreground/80">{edu.subtitle}</p>}
                                <p class="text-xs text-muted-foreground">{edu.institution}</p>
                                {edu.details?.map((detail) => (
                                    <p class="text-xs text-foreground/80">{detail}</p>
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.skills && resume.skills.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Shield size={14} class="text-muted-foreground" />
                        <span>Technical Skills</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {resume.skills.map((cat) => (
                            <div class="p-3.5 border border-border/60 rounded-md bg-card">
                                <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{cat.category}</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {cat.items.map((skill) => (
                                        <span class="text-xs px-2 py-0.5 rounded border border-border bg-card font-mono text-muted-foreground">
                                            {skill}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.certifications && resume.certifications.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <BadgeCheck size={14} class="text-muted-foreground" />
                        <span>Certifications</span>
                    </h2>
                    <div class="space-y-3">
                        {resume.certifications.map((cert) => (
                            <div class="border-l-2 border-border/60 pl-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                <h3 class="text-sm font-semibold text-foreground">
                                    {cert.url
                                        ? <a href={cert.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{cert.name}</a>
                                        : cert.name}
                                    {cert.issuer && <span class="text-muted-foreground font-normal"> @ {cert.issuer}</span>}
                                </h3>
                                {cert.date && <span class="text-xs text-muted-foreground shrink-0">{cert.date}</span>}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {resume.awards && resume.awards.length > 0 && (
                <div class="mb-10">
                    <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4 flex items-center gap-2">
                        <Award size={14} class="text-muted-foreground" />
                        <span>Awards</span>
                    </h2>
                    <div class="space-y-4">
                        {resume.awards.map((award) => (
                            <div class="border-l-2 border-border/60 pl-4 space-y-1">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                                    <h3 class="text-sm font-semibold text-foreground">
                                        {award.url
                                            ? <a href={award.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{award.title}</a>
                                            : award.title}
                                    </h3>
                                    <span class="text-xs text-muted-foreground shrink-0">{award.date}</span>
                                </div>
                                <p class="text-xs text-muted-foreground">{award.detail}</p>
                            </div>
                        ))}
                    </div>
                </div>
            )}
        </div>
    </section>

</Base>
