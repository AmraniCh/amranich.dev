---
// Switches between light and dark mode. The choice is saved in localStorage
// with the OS theme of that moment; Base.astro applies it before the page
// renders, but only while the OS theme is still the same. Hidden without
// JavaScript: the page then simply follows the system setting.
import { Sun, Moon } from '@lucide/astro';
---

<button
    type="button"
    data-theme-toggle
    aria-label="Switch to dark mode"
    title="Switch to dark mode"
    hidden
    class="inline-flex items-center text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
>
    <span class="dark:hidden"><Moon size={16} /></span>
    <span class="hidden dark:inline"><Sun size={16} /></span>
</button>

<script>
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (button) {
        const root = document.documentElement;
        const update = () => {
            const label = root.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode';
            button.setAttribute('aria-label', label);
            button.title = label;
        };

        button.hidden = false;
        update();

        const system = matchMedia('(prefers-color-scheme: dark)');

        button.addEventListener('click', () => {
            const dark = root.classList.toggle('dark');
            try {
                // Remember the OS theme too, so the choice is dropped when the OS changes.
                localStorage.setItem('theme', dark ? 'dark' : 'light');
                localStorage.setItem('theme-os', system.matches ? 'dark' : 'light');
            } catch {
                // Storage can be blocked; the switch still works for this page.
            }
            update();
        });

        // When the OS theme changes, follow it and forget the manual choice.
        system.addEventListener('change', (event) => {
            try {
                localStorage.removeItem('theme');
                localStorage.removeItem('theme-os');
            } catch {}
            root.classList.toggle('dark', event.matches);
            update();
        });
    }
</script>
