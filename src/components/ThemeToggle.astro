---
import { Sun, Moon } from "@lucide/astro";
---

<button
    type="button"
    data-theme-toggle
    aria-label="Switch to dark mode"
    title="Switch to dark mode"
    hidden
    class="inline-flex items-center text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
>
    <span class="dark:hidden">
        <Moon size={16} />
    </span>
    <span class="hidden dark:inline">
        <Sun size={16} />
    </span>
</button>

<script>
    const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (button) {
        const root = document.documentElement;
        const update = () => {
            const label = root.classList.contains("dark") ? "Switch to light mode" : "Switch to dark mode";
            button.setAttribute("aria-label", label);
            button.title = label;
        };

        button.hidden = false;
        update();

        const system = matchMedia("(prefers-color-scheme: dark)");

        button.addEventListener("click", () => {
            const dark = root.classList.toggle("dark");
            root.classList.toggle("light", !dark);
            try {
                // save the os theme too, the choice is dropped when it changes
                localStorage.setItem("theme", dark ? "dark" : "light");
                localStorage.setItem("theme-os", system.matches ? "dark" : "light");
            } catch {}
            update();
        });

        system.addEventListener("change", event => {
            try {
                localStorage.removeItem("theme");
                localStorage.removeItem("theme-os");
            } catch {}
            root.classList.toggle("dark", event.matches);
            root.classList.toggle("light", !event.matches);
            update();
        });
    }
</script>
