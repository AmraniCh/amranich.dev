---
import { info } from '../lib/info.ts';

// The blog is hidden while "blog" is false in public/0user.json.
// To show it again, set it to true and rename src/pages/_blog and
// src/pages/_tags back to blog and tags (Astro skips "_" folders).
const links = [
  { href: '/', label: 'Home' },
  ...(info.blog ? [
    { href: '/blog', label: 'Blog' },
    { href: '/tags', label: 'Tags' },
  ] : []),
  { href: '/open-source', label: 'Open Source' },
  { href: '/resume', label: 'Resume' },
];
const pathname = Astro.url.pathname;
function isActiveHref(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
function linkClass(href: string) {
  const active = isActiveHref(href);
  return `text-sm transition-colors ${active ? 'text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'}`;
}
---
<nav class="sticky top-0 z-50">
  <div class="container mx-auto px-6">
    <div class="flex h-16 items-center justify-center">
      <div class="flex items-center gap-6">
        {links.map((l) => (
          <a href={l.href} class={linkClass(l.href)} aria-current={isActiveHref(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</nav>