---
import { info } from "../lib/info.ts";
import ThemeToggle from "./ThemeToggle.astro";

// to show the blog: set "blog" to true in 0user.json and rename the _blog and _tags pages folders
const links = [
    { href: "/", label: "Home" },
    ...(info.blog
        ? [
              { href: "/blog/", label: "Blog" },
              { href: "/tags/", label: "Tags" },
          ]
        : []),
    { href: "/recent-work/", label: "Recent work" },
    { href: "/resume/", label: "Resume" },
    { href: "/presentations/", label: "Presentations" },
    { href: "/open-source/", label: "Open Source" },
];
const pathname = Astro.url.pathname;
function isActiveHref(href: string) {
    if (href === "/") return pathname === "/";
    const section = href.replace(/\/$/, "");
    return pathname === section || pathname.startsWith(section + "/");
}
function linkClass(href: string) {
    const active = isActiveHref(href);
    return `text-sm whitespace-nowrap transition-colors ${active ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`;
}
---

<nav class="sticky top-0 z-50 bg-background">
    <div class="container mx-auto px-6">
        <div class="flex min-h-16 items-center justify-center py-3">
            <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:gap-x-6">
                {links.map(l => (
                    <a href={l.href} class={linkClass(l.href)} aria-current={isActiveHref(l.href) ? "page" : undefined}>
                        {l.label}
                    </a>
                ))}
                <ThemeToggle />
            </div>
        </div>
    </div>
</nav>
