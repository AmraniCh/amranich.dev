    "projects": [
        {
            "title": "NeuralCodec-RPi",
            "repo": "AmraniCh/neuralcodec-rpi",
            "subtitle": "Neural Speech Codec on Embedded Hardware for Low-Bandwidth Networks",
            "date": "Jun 2026 – Jul 2026",
            "paragraphs": [
                "A research oriented project on a real-time neural speech codec deployed on embedded hardware (two Raspberry Pi 4 boards) for low-bandwidth networks (3 to 6 kbps).",
                "Benchmarked 4 codecs (Opus, Codec2, EnCodec, SoundStream) on Pi hardware (Raspberry Pi 4) and measured the codecs' performance with PESQ quality and Real-Time Factor (RTF). SoundStream was selected for deployment.",
                "Built a UDP pipeline for live microphone-to-speaker voice transmission between two Pi boards over Ethernet (RJ45) and WiFi channels."
            ],
            "material": "Two Raspberry Pi 4 boards, USB microphone, RJ45 Ethernet cable, WiFi hotspot.",
            "stack": [
                "Python",
                "Bazel",
                "Lyra/SoundStream",
                "EnCodec",
                "UDP",
                "librosa",
                "PESQ",
                "Raspberry Pi",
